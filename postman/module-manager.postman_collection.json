							"body": "invalid limit"
						}
					]
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8778",
			"type": "string",
			"description": "Module Manager API base URL. Port comes from `.env` (`Port=8778`)."
		}
	]
